ble schema="main" name="Player" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="46"/><column index="3" value="38"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE Item(
	itemId INTEGER PRIMARY KEY,
	name TEXT NOT NULL,
	price INTEGER NOT NULL);</sql><sql name="SQL 2*">INSERT INTO Item (itemId, name, price)
VALUES (1, '회복 포션', 30);</sql><sql name="SQL 3*">INSERT INTO Item (itemId, name, price)
VALUES (2, '철 검', 100);

INSERT INTO Item (itemId, name, price)
VALUES (3, '나무 방패', 60);</sql><sql name="SQL 4*">SELECT name, price
FROM Item
WHERE price &gt;= 50;</sql><sql name="SQL 5*">UPDATE Item
SET price = 40
where itemId = 1;</sql><sql name="SQL 6*">DELETE FROM Item
WHERE itemId = 1;</sql><sql name="SQL 7*">SELECT PlayerId, Gold
FROM Player
WHERE PlayerId = 1;</sql><sql name="SQL 9*">SELECT PlayerId, itemId, Quantity
FROM Inventory
WHERE PlayerId = 1 AND itemId = 1;</sql><sql name="SQL 8*">COMMIT;

BEGIN;

UPDATE Player
SET Gold = 100
WHERE PlayerId = 1 AND Gold &gt;= 0;

UPDATE Inventory
SET Quantity = -1
WHERE PlayerId = 1 And itemId = 1;

ROLLBACK;</sql><current_tab id="8"/></tab_sql></sqlb_project>
